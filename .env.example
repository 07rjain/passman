# Set in the Vercel project environment. Never use NEXT_PUBLIC_ for server secrets.
APP_ORIGIN=http://localhost:3100
DATABASE_URL=postgresql://MVP_RUNTIME_USER:MVP_PASSWORD@localhost:5432/keyman_mvp
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Optional server-only Clerk backend credential supplied by the integration.
# Use the matching instance; the local session verifier uses the public settings below.
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_ISSUER=

# Optional: server-only endpoint secret for signed Clerk session audit webhooks.
CLERK_WEBHOOK_SIGNING_SECRET=
