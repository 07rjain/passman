{
  "name": "passman-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @keyman-mvp/core && npm run build -w @keyman-mvp/client && npm run build -w @keyman-mvp/web",
    "dev": "npm run build -w @keyman-mvp/core && npm run dev -w @keyman-mvp/web",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "node --import tsx --test test/*.integration.ts",
    "test:package": "node scripts/check-package.mjs",
    "db:migrate": "node --env-file-if-exists=.env.migrate --import tsx scripts/migrate.ts",
    "lint": "eslint packages apps test scripts examples distribution",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run build && npm run typecheck && npm run lint && npm test && npm run test:package && npm run docs:check",
    "release:build": "npm run build -w @keyman-mvp/core && npm run build -w @keyman-mvp/client && node distribution/build.mjs",
    "release:version": "node distribution/version.mjs",
    "test:distribution": "node distribution/check.mjs",
    "format": "prettier --write .",
    "docs:check": "node scripts/check-docs.mjs",
    "audit:prune": "node --env-file-if-exists=.env.migrate --import tsx scripts/audit-prune.ts",
    "audit:operation": "node --env-file-if-exists=.env.migrate --import tsx scripts/audit-operation.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "jose": "6.2.14"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/07rjain/passman.git"
  }
}
